# OpenAI-compatible root of a Timeweb Cloud AI Agent. No /chat/completions suffix.
# Swap the agent by replacing <access-id> and TIMEWEB_API_KEY, then restart.
#   https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
# The agent access key is shown once in the agent dashboard. It is not the account API key
# and not an AI Gateway key (https://api.timeweb.ai/v1 is a different product).
TIMEWEB_API_KEY=
TIMEWEB_BASE_URL=https://agent.timeweb.cloud/api/v1/cloud-ai/agents/<access-id>/v1
# Sent as `model`. An AI Agent endpoint ignores it and uses the model configured on the agent.
TIMEWEB_MODEL=deepseek-v4-flash
# Path to the gateway system prompt (.md). Relative paths are from the process working directory.
SYSTEM_PROMPT_PATH=prompts/alice_system.md
# Seconds this process may wait for the model before telling Alice to ask again. Dialogs drop the skill after 4.5s total.
ALICE_REPLY_BUDGET_SECONDS=3
HOST=0.0.0.0
PORT=8080
