# Runtime only. Do not commit the key and do not pass it as a Docker build argument.
# GitHub: repository secret LLM_API_KEY. The process reads the same name from the environment.
LLM_API_KEY=
# OpenAI-compatible root. No /chat/completions suffix. Default is DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# Path to the gateway system prompt (.md). Relative paths are from the process working directory.
SYSTEM_PROMPT_PATH=prompts/alice_system.md
# Seconds this process may wait for the model before telling Alice to ask again. Dialogs drop the skill after 4.5s total.
ALICE_REPLY_BUDGET_SECONDS=3
# Open Alice sessions at once for one Yandex account, or one device when the account id is absent.
MAX_OPEN_SESSIONS=1
# A session with no further requests stops counting as open after this many seconds.
OPEN_SESSION_IDLE_SECONDS=1800
HOST=0.0.0.0
PORT=8080
